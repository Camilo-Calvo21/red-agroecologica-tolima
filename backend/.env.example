# ─────────────────────────────────────────────────────────────
# Variables de entorno del backend
# ─────────────────────────────────────────────────────────────
# Local: copia este archivo a .env y rellena los valores.
# Producción: configurar en Render → Environment Variables.

# Entorno
ENV=development
DEBUG=true

# Supabase — obtén estos valores en https://supabase.com/dashboard
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_JWT_SECRET=tu-jwt-secret

# Cloudinary — obtén estos valores en https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=tu-api-secret

# CORS — separar dominios con coma
CORS_ORIGINS=http://localhost:5173,https://tu-app.vercel.app
