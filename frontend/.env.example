# ─────────────────────────────────────────────────────────────
# Variables de entorno del frontend
# ─────────────────────────────────────────────────────────────
# Local: cp .env.example .env  y edita los valores
# Producción: configurar en Vercel → Settings → Environment Variables

# URL del backend (FastAPI en Render)
# Local: http://localhost:8000
# Producción: https://tu-backend.onrender.com
VITE_API_URL=http://localhost:8000

# Supabase — proyecto público, valores anon (no service_key)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
